PORT=5050
NODE_ENV=development
FRONTEND_URL=https://www.nightmarestore.site
BACKEND_URL=https://nightmare-store-backend.onrender.com
APP_BASE_URL=https://www.nightmarestore.site
API_BASE_URL=https://nightmare-store-backend.onrender.com
SESSION_SECRET=your_session_secret_here

# --- Supabase Database & Auth Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# --- Discord OAuth Application Credentials ---
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://www.nightmarestore.site/auth/discord/callback

# --- Discord Bot & Role Verification ---
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id
DISCORD_VERIFIED_ROLE_ID=your_role_id
DISCORD_VERIFICATION_CHANNEL_ID=your_channel_id

# --- Google reCAPTCHA v2 ---
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.nightmarestore.site/auth/google/callback
GOOGLE_CALLBACK_URL=https://your-project.supabase.co/auth/v1/callback

# --- Payment & Encryption ---
PAYMENT_PROVIDER_SECRET=test_sk_da_ra_store_secret
PAYMENT_WEBHOOK_SECRET=test_whsec_cyberpunk_marketplace_key
DIGITAL_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Resend Email Delivery ---
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=NightmareStore Security <onboarding@resend.dev>
ADMIN_OTP_EMAIL=your_admin_email@example.com

# --- CutLuy Payment Gateway ---
CUTLUY_API_KEY=your_cutluy_api_key
CUTLUY_BASE_URL=https://cutluy.com/v1
CUTLUY_WEBHOOK_SECRET=your_webhook_secret
